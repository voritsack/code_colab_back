# ---------------------------------------------------------------------------
# CodeColab backend configuration.
#
# Copy to `.env` and fill in real values. `.env` is gitignored - keep it that
# way. Real environment variables always win over this file, so a host that
# injects its own configuration needs no file at all.
#
# Deploying to a panel or PaaS: upload this as `.env` next to `main.py`
# (the repository root), or set the same names as environment variables.
# ---------------------------------------------------------------------------

APP_NAME=CodeColab
ENVIRONMENT=production
DEBUG=false

# The origin invited people will open. This is what goes into every invite
# link, so it must be reachable from their machines - not 127.0.0.1.
PUBLIC_BASE_URL=https://your-domain.example

# Bind address. Containers need 0.0.0.0; a laptop is safer on 127.0.0.1.
HOST=0.0.0.0
# Fallback port. Hosts that assign a port set SERVER_PORT (or PORT) as a real
# environment variable, and that always wins over this line.
PORT=8000

# Only true when a reverse proxy terminates the connection in front of this
# server. On a directly exposed port, X-Forwarded-For is attacker controlled
# and trusting it defeats the rate limiter.
TRUST_PROXY_HEADERS=false

# ---- Security -------------------------------------------------------------
# Minimum 32 characters. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=replace-me-with-a-long-random-string

SESSION_TOKEN_TTL_HOURS=12
ADMIN_SESSION_TTL_MINUTES=480

# Leave empty unless a browser app needs the API. The VS Code extension does not.
CORS_ORIGINS=
# Comma-separated hostnames the server will answer for. Empty disables the
# check. Ports are ignored, so "example.com" also matches "example.com:8000".
TRUSTED_HOSTS=

# Leave unset to derive from PUBLIC_BASE_URL (https -> Secure cookies).
# SECURE_COOKIES=true

# ---- Accounts -------------------------------------------------------------
# Created (or promoted) on startup so the dashboard is reachable on a fresh db.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-me
ADMIN_NAME=Administrator
ADMIN_RESET_PASSWORD=false

# ---- Sessions -------------------------------------------------------------
# Optional shared secret needed to START a session (never to join one).
# Empty means anyone who can reach this server can host.
HOST_ACCESS_CODE=

ALLOW_GUESTS_DEFAULT=true
REQUIRE_APPROVAL_DEFAULT=true
MAX_PARTICIPANTS=25

# Housekeeping. Files, drawings and chat from a finished session are
# deleted this many hours after it goes quiet; the session record itself
# survives for RETENTION_DAYS so the dashboard still has something to show.
# Files passed round a session (images, zips, docs). Stored on disk, not in
# the database, and deleted when the session ends.
ATTACHMENT_DIR=./data/attachments
MAX_ATTACHMENT_BYTES=25000000
MAX_SESSION_ATTACHMENT_BYTES=150000000
MAX_ATTACHMENTS_PER_SESSION=60

# A session with nobody connected ends itself after this long.
EMPTY_SESSION_GRACE_SECONDS=120

ARTEFACT_RETENTION_HOURS=6
RETENTION_DAYS=30
SWEEP_INTERVAL_MINUTES=60

# ---- Payload limits -------------------------------------------------------
MAX_FILE_BYTES=512000
MAX_FILES_PER_SNAPSHOT=2000
MAX_SNAPSHOT_BYTES=25000000
MAX_WS_MESSAGE_BYTES=2000000

# ---- Rate limits ----------------------------------------------------------
LOGIN_RATE_LIMIT=10
LOGIN_RATE_WINDOW_SECONDS=300
JOIN_RATE_LIMIT=20
JOIN_RATE_WINDOW_SECONDS=300
SESSION_CREATE_RATE_LIMIT=20
SESSION_CREATE_RATE_WINDOW_SECONDS=3600
WS_MESSAGE_RATE_LIMIT=240
WS_MESSAGE_RATE_WINDOW_SECONDS=10

# ---- Database -------------------------------------------------------------
# MySQL / MariaDB (aiomysql is in requirements.txt). Percent-encode any of
# : / ? # [ ] @ + ^ ! that appear in the password.
DATABASE_URL=mysql+aiomysql://user:password@host:3306/dbname?charset=utf8mb4
# PostgreSQL:  postgresql+asyncpg://user:password@host:5432/dbname
# SQLite:      sqlite+aiosqlite:///./codecolab.db
DATABASE_ECHO=false

# ---- VS Code deep link ----------------------------------------------------
# <publisher>.<name> from the extension's package.json.
VSCODE_EXTENSION_ID=voritsack.codecolab
