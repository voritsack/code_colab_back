# ---------------------------------------------------------------------------
# CodeColab backend configuration.
# Copy to `.env` and fill in real values. `.env` is gitignored - keep it that way.
# ---------------------------------------------------------------------------

APP_NAME=CodeColab
ENVIRONMENT=development
DEBUG=false

# The origin invited people will open. Must be reachable from their machines,
# so 127.0.0.1 only works when everyone is on this computer. Use a tunnel
# (cloudflared, ngrok) or a real host for anything else.
PUBLIC_BASE_URL=http://127.0.0.1:8000
HOST=127.0.0.1
PORT=8000

# ---- Security -------------------------------------------------------------
# Minimum 32 characters. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=replace-me-with-a-long-random-string

ACCESS_TOKEN_TTL_MINUTES=30
REFRESH_TOKEN_TTL_DAYS=30
SESSION_TOKEN_TTL_HOURS=12
ADMIN_SESSION_TTL_MINUTES=480

# Leave empty unless a browser app needs the API. The VS Code extension does not.
CORS_ORIGINS=
# Comma-separated hostnames the server will answer for. Empty disables the check.
TRUSTED_HOSTS=
# Leave unset to derive from PUBLIC_BASE_URL (https -> secure cookies).
# SECURE_COOKIES=true

# ---- Accounts -------------------------------------------------------------
ALLOW_REGISTRATION=true
# Created (or promoted) on startup so the dashboard is reachable on a fresh db.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-me
ADMIN_NAME=Administrator

# ---- Sessions -------------------------------------------------------------
ALLOW_GUESTS_DEFAULT=true
REQUIRE_APPROVAL_DEFAULT=true
MAX_PARTICIPANTS=25

# ---- Payload limits -------------------------------------------------------
MAX_FILE_BYTES=512000
MAX_FILES_PER_SNAPSHOT=2000
MAX_SNAPSHOT_BYTES=25000000
MAX_WS_MESSAGE_BYTES=2000000

# ---- Rate limits ----------------------------------------------------------
LOGIN_RATE_LIMIT=10
LOGIN_RATE_WINDOW_SECONDS=300
JOIN_RATE_LIMIT=20
JOIN_RATE_WINDOW_SECONDS=300
REGISTER_RATE_LIMIT=20
REGISTER_RATE_WINDOW_SECONDS=3600
WS_MESSAGE_RATE_LIMIT=240
WS_MESSAGE_RATE_WINDOW_SECONDS=10

# ---- Database -------------------------------------------------------------
# MySQL / MariaDB (needs `pip install aiomysql`). Percent-encode any of
# : / ? # [ ] @ + ^ ! that appear in the password.
DATABASE_URL=mysql+aiomysql://user:password@host:3306/dbname?charset=utf8mb4
# PostgreSQL:  postgresql+asyncpg://user:password@host:5432/dbname
# SQLite:      sqlite+aiosqlite:///./codecolab.db
DATABASE_ECHO=false

# ---- VS Code deep link ----------------------------------------------------
# <publisher>.<name> from the extension's package.json.
VSCODE_EXTENSION_ID=local.codecolab
